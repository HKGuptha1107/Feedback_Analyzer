# Database Configuration
# Default to SQLite for immediate local development with zero setup.
# For Docker or local PostgreSQL, use: postgresql+psycopg2://postgres:postgres@localhost:5432/feedback_intelligence
DATABASE_URL=sqlite:///./feedback_intelligence.db

# Groq LLM Configuration
# Recommended model from hackathon document: openai/gpt-oss-120b
# Fallback models: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Memory Configuration
# Official Hindsight Cloud API: https://api.hindsight.vectorize.io
# For local self-hosted Hindsight server: http://localhost:8888
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=flowdesk-feedback-bank

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
